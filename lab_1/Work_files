tac "Text @1" > "Sorokin Nikita Vasilyevich/Result_one"
mv "Sorokin Nikita Vasilyevich/Result_one" "Sorokin Nikita Vasilyevich/Result_two"

ls "Sorokin Nikita Vasilyevich" | grep '^T' | xargs -I {} sh -c 'cat "Sorokin Nikita Vasilyevich/{}" >> "Лабораторная работа №1!/Result_3"'
{ uname -a; date; } >> "Лабораторная работа №1!/Result_3"

mkdir sandbox
mv Sorokin.asm Sorokin.o a.out C_version.c c_version Disassemble.txt sandbox/
