mkdir Work
cd Work
mkdir "Лабораторная работа №1!"
mkdir "Sorokin Nikita Vasilyevich"
chmod 772 "Лабораторная работа №1!"
chmod 200 "Sorokin Nikita Vasilyevich"

touch "Text @1"
touch "Text $2"
touch "Text #3"

echo "Птица говорун отличается умом и сообразительностью!" > "Text @1"
echo "Отличается умом, отличается сообразительностью..." >> "Text @1"
cat "Text @1" > "Text $2"
mv "Text $2" "Лабораторная работа №1!"
cp "Text @1" "Sorokin Nikita Vasilyevich"

gzip -c "Text @1" > "Text @1.gz"
gzip -c "Text #3" > "Text #3.gz"
tar -cf MyAchiv "Text @1.gz" "Text #3.gz"

head -n 1 "Text @1" > "Text #3"
