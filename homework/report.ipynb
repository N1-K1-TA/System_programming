        "### 4. Makefile"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%%writefile Makefile\n",
        "CC = gcc\n",
        "ASM = fasm\n",
        "CFLAGS = -Wall -Wextra -O2\n",
        "\n",
        "TARGET = main_prog\n",
        "OBJS = main.o array.o\n",
        "\n",
        "all: $(TARGET)\n",
        "\n",
        "$(TARGET): $(OBJS)\n",
        "\t$(CC) $(CFLAGS) -o $(TARGET) $(OBJS)\n",
        "\n",
        "main.o: main.c array.h\n",
        "\t$(CC) $(CFLAGS) -c main.c -o main.o\n",
        "\n",
        "array.o: array.asm\n",
        "\t$(ASM) array.asm array.o\n",
        "\n",
        "clean:\n",
        "\trm -f $(OBJS) $(TARGET)\n",
        "\n",
        "run: all\n",
        "\t./$(TARGET)\n",
        "\n",
        ".PHONY: all clean run\n"
      ]
    },
