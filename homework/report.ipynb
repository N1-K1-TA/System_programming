      "source": [
        "# Отчет по домашнему заданию\n",
        "## Вариант 19\n",
        "\n",
        "**Выполнил:** Сорокин Никита\n",
        "**Группа:** ИУ5-35Б  \n",
        "\n",
        "---\n",
        "\n",
        "### Результаты генерации условий для варианта 19\n",
        "Формула инициализации случайных чисел: `seed(Variant + 1113332224456)` для `Variant = 19`:\n",
        "* **Структура данных:** Массив\n",
        "* **Метод выделения памяти:** Анонимное отображение (`mmap`)\n",
        "* **Список функций (действий):**\n",
        "  1. `Создание массива заданного размера`\n",
        "  2. `Заполнение случайными числами`\n",
        "  3. `Получение списка нечетных чисел`\n",
        "  4. `Подсчет количества простых чисел`\n",
        "  5. `Реверсирование элементов массива`"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 1. Заголовочный файл C (`array.h`)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%%writefile array.h\n",
        "#ifndef ARRAY_H\n",
        "#define ARRAY_H\n",
        "\n",
        "#include <stddef.h>\n",
        "\n",
        "#ifdef __cplusplus\n",
        "extern \"C\" {\n",
        "#endif\n",
        "\n",
        "// Создание массива заданного размера через анонимное отображение (mmap)\n",
        "int* create_array(size_t size);\n",
        "\n",
        "// Освобождение памяти массива (munmap)\n",
        "void free_array(int* ptr, size_t size);\n",
        "\n",
        "// Заполнение массива случайными числами в диапазоне [min_val, max_val]\n",
        "void fill_random(int* ptr, size_t size, int min_val, int max_val);\n",
        "\n",
        "// Получение списка нечетных чисел\n",
        "size_t get_odd_numbers(const int* src, size_t src_size, int* dst);\n",
        "\n",
        "// Подсчет количества простых чисел в массиве\n",
        "size_t count_primes(const int* ptr, size_t size);\n",
        "\n",
        "// Реверсирование элементов массива на месте\n",
        "void reverse_array(int* ptr, size_t size);\n",
        "\n",
        "#ifdef __cplusplus\n",
        "}\n",
        "#endif\n",
        "\n",
        "#endif // ARRAY_H\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 2. Реализация функций на FASM (`array.asm`)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%%writefile array.asm\n",
        "; array.asm - Реализация функций работы с массивом на FASM (x86_64 Linux)\n",
        "format ELF64\n",
        "\n",
        "section '.text' executable\n",
        "\n",
        "public create_array\n",
        "public free_array\n",
        "public fill_random\n",
        "public get_odd_numbers\n",
        "public count_primes\n",
        "public reverse_array\n",
        "\n",
        "; Номера системных вызовов Linux x86_64\n",
        "SYS_MMAP      equ 9\n",
        "SYS_MUNMAP    equ 11\n",
        "SYS_GETRANDOM equ 318\n",
        "\n",
        "; Флаги mmap\n",
        "PROT_READ     equ 1\n",
        "PROT_WRITE    equ 2\n",
        "MAP_PRIVATE   equ 0x02\n",
        "MAP_ANONYMOUS equ 0x20\n",
        "\n",
        "; -------------------------------------------------------------\n",
        "; int* create_array(size_t size)\n",
        "; rdi = size (в элементах int)\n",
        "; -------------------------------------------------------------\n",
        "create_array:\n",
        "    push rbp\n",
        "    mov rbp, rsp\n",
        "\n",
        "    shl rdi, 2               ; size * sizeof(int)\n",
        "    jz .err                  ; если size == 0, возврат NULL\n",
        "\n",
        "    mov rsi, rdi             ; length\n",
        "    xor rdi, rdi             ; addr = NULL\n",
        "    mov rdx, PROT_READ or PROT_WRITE\n",
        "    mov r10, MAP_PRIVATE or MAP_ANONYMOUS\n",
        "    mov r8, -1               ; fd = -1\n",
        "    xor r9, r9               ; offset = 0\n",
        "    mov rax, SYS_MMAP\n",
        "    syscall\n",
        "\n",
        "    cmp rax, -4095\n",
        "    jae .err\n",
        "    leave\n",
        "    ret\n",
        ".err:\n",
        "    xor rax, rax\n",
        "    leave\n",
        "    ret\n",
        "\n",
        "; -------------------------------------------------------------\n",
        "; void free_array(int* ptr, size_t size)\n",
        "; rdi = ptr, rsi = size\n",
        "; -------------------------------------------------------------\n",
        "free_array:\n",
        "    push rbp\n",
        "    mov rbp, rsp\n",
        "\n",
        "    test rdi, rdi\n",
        "    jz .done\n",
        "    test rsi, rsi\n",
        "    jz .done\n",
        "\n",
        "    shl rsi, 2               ; length = size * 4\n",
        "    mov rax, SYS_MUNMAP\n",
        "    syscall\n",
        "\n",
        ".done:\n",
        "    leave\n",
        "    ret\n",
        "\n",
        "; -------------------------------------------------------------\n",
        "; void fill_random(int* ptr, size_t size, int min_val, int max_val)\n",
        "; rdi = ptr, rsi = size, edx = min_val, ecx = max_val\n",
        "; -------------------------------------------------------------\n",
        "fill_random:\n",
        "    push rbp\n",
        "    mov rbp, rsp\n",
        "    push r12\n",
        "    push r13\n",
        "    push r14\n",
        "    push r15\n",
        "    push rbx\n",
        "\n",
        "    test rdi, rdi\n",
        "    jz .fill_done\n",
        "    test rsi, rsi\n",
        "    jz .fill_done\n",
        "\n",
        "    mov r12, rdi             ; ptr\n",
        "    mov r13, rsi             ; size\n",
        "    mov r14d, edx            ; min_val\n",
        "    mov r15d, ecx            ; max_val\n",
        "    sub r15d, r14d           ; range = max - min + 1\n",
        "    inc r15d\n",
        "    cmp r15d, 0\n",
        "    jle .fill_done\n",
        "\n",
        "    xor rbx, rbx             ; i = 0\n",
        ".loop_fill:\n",
        "    cmp rbx, r13\n",
        "    jge .fill_done\n",
        "\n",
        "    sub rsp, 16\n",
        "    mov rdi, rsp\n",
        "    mov rsi, 4\n",
        "    xor rdx, rdx\n",
        "    mov rax, SYS_GETRANDOM\n",
        "    syscall\n",
        "    mov eax, dword [rsp]\n",
        "    add rsp, 16\n",
        "\n",
        "    ; eax = abs(eax)\n",
        "    mov edx, eax\n",
        "    sar edx, 31\n",
        "    xor eax, edx\n",
        "    sub eax, edx\n",
        "\n",
        "    xor rdx, rdx\n",
        "    div r15d                 ; edx = eax % range\n",
        "    add edx, r14d            ; val = min_val + edx\n",
        "\n",
        "    mov dword [r12 + rbx*4], edx\n",
        "    inc rbx\n",
        "    jmp .loop_fill\n",
        "\n",
        ".fill_done:\n",
        "    pop rbx\n",
        "    pop r15\n",
        "    pop r14\n",
        "    pop r13\n",
        "    pop r12\n",
        "    leave\n",
        "    ret\n",
        "\n",
        "; -------------------------------------------------------------\n",
        "; size_t get_odd_numbers(const int* src, size_t src_size, int* dst)\n",
        "; rdi = src, rsi = src_size, rdx = dst\n",
        "; -------------------------------------------------------------\n",
        "get_odd_numbers:\n",
        "    push rbp\n",
        "    mov rbp, rsp\n",
        "\n",
        "    xor rax, rax             ; count = 0\n",
        "    test rdi, rdi\n",
        "    jz .odd_done\n",
        "    test rdx, rdx\n",
        "    jz .odd_done\n",
        "    test rsi, rsi\n",
        "    jz .odd_done\n",
        "\n",
        "    xor rcx, rcx             ; i = 0\n",
        ".loop_odd:\n",
        "    cmp rcx, rsi\n",
        "    jge .odd_done\n",
        "\n",
        "    mov r8d, dword [rdi + rcx*4]\n",
        "    test r8d, 1\n",
        "    jz .skip_odd\n",
        "\n",
        "    mov dword [rdx + rax*4], r8d\n",
        "    inc rax\n",
        "\n",
        ".skip_odd:\n",
        "    inc rcx\n",
        "    jmp .loop_odd\n",
        "\n",
        ".odd_done:\n",
        "    leave\n",
        "    ret\n",
        "\n",
        "; -------------------------------------------------------------\n",
        "; size_t count_primes(const int* ptr, size_t size)\n",
        "; rdi = ptr, rsi = size\n",
        "; -------------------------------------------------------------\n",
        "count_primes:\n",
        "    push rbp\n",
        "    mov rbp, rsp\n",
        "    push rbx\n",
        "    push r12\n",
        "\n",
        "    xor rbx, rbx             ; total prime count = 0\n",
        "    test rdi, rdi\n",
        "    jz .prime_done\n",
        "    test rsi, rsi\n",
        "    jz .prime_done\n",
        "\n",
        "    xor r12, r12             ; i = 0\n",
        ".loop_prime:\n",
        "    cmp r12, rsi\n",
        "    jge .prime_done\n",
        "\n",
        "    mov edx, dword [rdi + r12*4]\n",
        "    cmp edx, 2\n",
        "    jl .next_elem\n",
        "\n",
        "    mov ecx, 2\n",
        ".check_div:\n",
        "    mov eax, ecx\n",
        "    imul eax, ecx\n",
        "    cmp eax, edx\n",
        "    jg .is_prime_val\n",
        "\n",
        "    mov eax, edx\n",
        "    push rdx\n",
        "    xor rdx, rdx\n",
        "    div ecx\n",
        "    pop r8\n",
        "    test rdx, rdx\n",
        "    jz .next_elem\n",
        "\n",
        "    inc ecx\n",
        "    jmp .check_div\n",
        "\n",
        ".is_prime_val:\n",
        "    inc rbx\n",
        "\n",
        ".next_elem:\n",
        "    inc r12\n",
        "    jmp .loop_prime\n",
        "\n",
        ".prime_done:\n",
        "    mov rax, rbx\n",
        "    pop r12\n",
        "    pop rbx\n",
        "    leave\n",
        "    ret\n",
        "\n",
        "; -------------------------------------------------------------\n",
        "; void reverse_array(int* ptr, size_t size)\n",
        "; rdi = ptr, rsi = size\n",
        "; -------------------------------------------------------------\n",
        "reverse_array:\n",
        "    push rbp\n",
        "    mov rbp, rsp\n",
        "\n",
        "    test rdi, rdi\n",
        "    jz .rev_done\n",
        "    cmp rsi, 1\n",
        "    jle .rev_done\n",
        "\n",
        "    xor rax, rax             ; left = 0\n",
        "    mov r8, rsi\n",
        "    dec r8                   ; right = size - 1\n",
        "\n",
        ".loop_rev:\n",
        "    cmp rax, r8\n",
        "    jge .rev_done\n",
        "\n",
        "    mov ecx, dword [rdi + rax*4]\n",
        "    mov edx, dword [rdi + r8*4]\n",
        "\n",
        "    mov dword [rdi + rax*4], edx\n",
        "    mov dword [rdi + r8*4], ecx\n",
        "\n",
        "    inc rax\n",
        "    dec r8\n",
        "    jmp .loop_rev\n",
        "\n",
        ".rev_done:\n",
        "    leave\n",
        "    ret\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 3. Демонстрационная программа на C (`main.c`)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%%writefile main.c\n",
        "#include <stdio.h>\n",
        "#include <stdlib.h>\n",
        "#include \"array.h\"\n",
        "\n",
        "void print_array(const char* label, const int* arr, size_t size) {\n",
        "    printf(\"%s [размер %zu]: \", label, size);\n",
        "    for (size_t i = 0; i < size; ++i) {\n",
        "        printf(\"%d \", arr[i]);\n",
        "    }\n",
        "    printf(\"\\n\");\n",
        "}\n",
        "\n",
        "int main() {\n",
        "    size_t n = 12;\n",
        "    printf(\"=== Демонстрация работы с массивом в анонимной памяти (FASM + C) ===\\n\\n\");\n",
        "\n",
        "    // 1. Создание массива заданного размера через mmap\n",
        "    int* arr = create_array(n);\n",
        "    if (!arr) {\n",
        "        fprintf(stderr, \"Ошибка: не удалось выделить память через mmap!\\n\");\n",
        "        return 1;\n",
        "    }\n",
        "    printf(\"1. Массив успешно создан в анонимном отображении (mmap) по адресу: %p\\n\", (void*)arr);\n",
        "\n",
        "    // 2. Заполнение случайными числами\n",
        "    fill_random(arr, n, 1, 50);\n",
        "    print_array(\"2. Исходный массив (заполнен случайными числами [1..50])\", arr, n);\n",
        "\n",
        "    // 3. Подсчет количества простых чисел\n",
        "    size_t primes_count = count_primes(arr, n);\n",
        "    printf(\"3. Количество простых чисел в массиве: %zu\\n\", primes_count);\n",
        "\n",
        "    // 4. Получение списка нечетных чисел\n",
        "    int* odd_arr = create_array(n);\n",
        "    if (odd_arr) {\n",
        "        size_t odd_count = get_odd_numbers(arr, n, odd_arr);\n",
        "        print_array(\"4. Список нечетных чисел\", odd_arr, odd_count);\n",
        "        free_array(odd_arr, n);\n",
        "    }\n",
        "\n",
        "    // 5. Реверсирование элементов массива\n",
        "    reverse_array(arr, n);\n",
        "    print_array(\"5. Массив после реверсирования\", arr, n);\n",
        "\n",
        "    // Освобождение памяти\n",
        "    free_array(arr, n);\n",
        "    printf(\"\\nПамять успешно освобождена через munmap.\\n\");\n",
        "\n",
        "    return 0;\n",
        "}\n"
      ]
    },
